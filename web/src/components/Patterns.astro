// The home page's "show me the code" section: one tab per pattern Skipper is used for, each with a
// short explanation and the workflow that implements it.
import LangTabs from './LangTabs.astro';

const approvalJava = `public class PeerToPeerTransfer extends Workflow {
  private final Ledger ledger = actions(Ledger.class);

  @StateField Boolean isApproved;

  @WorkflowMethod(returnType = Boolean.class)
  public CompletableFuture<Boolean> transfer(TransferRequest request) {
    // Transfers over $1,000 need a human in the loop.
    if (request.getAmount() > 1000) {
      // Hibernate until approved — or up to a day — using zero resources.
      boolean approved = waitUntil(() -> isApproved != null, Duration.ofDays(1));
      if (!approved || !isApproved) {
        return CompletableFuture.completedFuture(false);
      }
    }
    ledger.debit(request.getFrom(), request.getAmount());
    ledger.credit(request.getTo(), request.getAmount());
    return CompletableFuture.completedFuture(true);
  }

  // A signal wakes the waiting workflow up from the outside world.
  @SignalMethod
  public void approve(boolean isApproved) {
    this.isApproved = isApproved;
  }
}`;

const approvalKotlin = `class PeerToPeerTransfer : Workflow() {
  private val ledger = actions<Ledger>()

  @StateField var isApproved: Boolean? = null

  @WorkflowMethod
  suspend fun transfer(request: TransferRequest): Boolean {
    // Transfers over $1,000 need a human in the loop.
    if (request.amount > 1000) {
      // Hibernate until approved — or up to a day — using zero resources.
      val approved = waitUntil({ isApproved != null }, Duration.ofDays(1))
      if (!approved || isApproved != true) return false
    }
    ledger.debit(request.from, request.amount)
    ledger.credit(request.to, request.amount)
    return true
  }

  // A signal wakes the waiting workflow up from the outside world.
  @SignalMethod
  fun approve(isApproved: Boolean) {
    this.isApproved = isApproved
  }
}`;

const sagaJava = `public class OrderWorkflow extends Workflow {
  private final PaymentActions payments = actions(PaymentActions.class);
  private final InventoryActions inventory = actions(InventoryActions.class);
  private final ShippingActions shipping = actions(ShippingActions.class);

  @WorkflowMethod(returnType = OrderResult.class)
  public CompletableFuture<OrderResult> process(OrderRequest order) {
    payments.charge(order);      // undone by refund if a later step fails
    inventory.reserve(order);    // undone by release if a later step fails
    shipping.schedule(order);    // if this throws, the two above are undone
    return CompletableFuture.completedFuture(OrderResult.completed(order.getId()));
  }
}

public class PaymentActions extends Actions {
  @Execute
  public String charge(OrderRequest order) {
    return gateway.charge(order);
  }

  // Receives the original input and what charge returned.
  @Compensate(forExecute = "charge")
  public void refund(OrderRequest order, String chargeId) {
    gateway.refund(chargeId);
  }
}`;

const sagaKotlin = `class OrderWorkflow : Workflow() {
  private val payments = actions<PaymentActions>()
  private val inventory = actions<InventoryActions>()
  private val shipping = actions<ShippingActions>()

  @WorkflowMethod
  suspend fun process(order: OrderRequest): OrderResult {
    payments.charge(order)      // undone by refund if a later step fails
    inventory.reserve(order)    // undone by release if a later step fails
    shipping.schedule(order)    // if this throws, the two above are undone
    return OrderResult.completed(order.id)
  }
}

class PaymentActions : Actions() {
  @Execute
  suspend fun charge(order: OrderRequest): String = gateway.charge(order)

  // Receives the original input and what charge returned.
  @Compensate(forExecute = "charge")
  suspend fun refund(order: OrderRequest, chargeId: String) {
    gateway.refund(chargeId)
  }
}`;

const agentJava = `public class ResearchAgent extends Workflow {
  private final ModelActions model = actions(ModelActions.class);
  private final ToolActions tools = actions(ToolActions.class);

  @WorkflowMethod(returnType = Answer.class)
  public CompletableFuture<Answer> run(Question question) {
    Transcript transcript = Transcript.startingWith(question);

    for (int turn = 0; turn < MAX_TURNS; turn++) {
      // One model call per turn. Checkpointed: never re-asked on resume.
      Step step = model.next(transcript);
      if (step.isFinal()) {
        return CompletableFuture.completedFuture(step.getAnswer());
      }
      // The tool the model picked runs once, and is retried on outages.
      ToolResult result = tools.call(step.getToolCall());
      transcript = transcript.plus(step, result);
    }
    // The loop is bounded by code, however the model behaves.
    return CompletableFuture.completedFuture(Answer.gaveUp());
  }
}`;

const agentKotlin = `class ResearchAgent : Workflow() {
  private val model = actions<ModelActions>()
  private val tools = actions<ToolActions>()

  @WorkflowMethod
  suspend fun run(question: Question): Answer {
    var transcript = Transcript.startingWith(question)

    repeat(MAX_TURNS) {
      // One model call per turn. Checkpointed: never re-asked on resume.
      val step = model.next(transcript)
      if (step.isFinal) return step.answer

      // The tool the model picked runs once, and is retried on outages.
      val result = tools.call(step.toolCall)
      transcript = transcript.plus(step, result)
    }
    // The loop is bounded by code, however the model behaves.
    return Answer.gaveUp()
  }
}`;

const teamJava = `public class ClaimWorkflow extends Workflow {
  @Inject IWorkflowFactory workflows;
  private final AgentActions agents = actions(AgentActions.class);

  @StateField Opinions opinions = Opinions.none();

  @WorkflowMethod(returnType = Decision.class)
  public CompletableFuture<Decision> handle(Claim claim) {
    // Fan out: each specialist agent is a durable workflow of its own.
    for (Specialist role : Specialist.values()) {
      workflows.builder(SpecialistWorkflow.class, getId() + "-" + role)
          .runAsync().detached().asChildOf(this).build()
          .review(new Task(claim, role));
    }
    // Join: wait for all three, or carry on with whoever answered in time.
    waitUntil(() -> opinions.size() == 3, Duration.ofMinutes(10));

    Decision decision = agents.adjudicate(opinions);
    return CompletableFuture.completedFuture(decision);
  }

  // Each specialist reports back with a signal when it is done.
  @SignalMethod
  public void opinion(Opinion opinion) {
    opinions = opinions.with(opinion);
  }
}`;

const teamKotlin = `class ClaimWorkflow : Workflow() {
  @Inject lateinit var workflows: IWorkflowFactory
  private val agents = actions<AgentActions>()

  @StateField var opinions = Opinions.none()

  @WorkflowMethod
  suspend fun handle(claim: Claim): Decision {
    // Fan out: each specialist agent is a durable workflow of its own.
    for (role in Specialist.values()) {
      workflows.builder<SpecialistWorkflow>("$id-$role")
        .runAsync().detached().asChildOf(this).build()
        .review(Task(claim, role))
    }
    // Join: wait for all three, or carry on with whoever answered in time.
    waitUntil({ opinions.size == 3 }, Duration.ofMinutes(10))

    return agents.adjudicate(opinions)
  }

  // Each specialist reports back with a signal when it is done.
  @SignalMethod
  fun opinion(opinion: Opinion) {
    opinions = opinions.with(opinion)
  }
}`;

const timerJava = `public class InvoiceCollection extends Workflow {
  private final Mailer mailer = actions(Mailer.class);

  @StateField Payment payment;

  @WorkflowMethod(returnType = Boolean.class)
  public CompletableFuture<Boolean> collect(Invoice invoice) {
    mailer.sendInvoice(invoice);

    for (int reminder = 1; reminder <= 3; reminder++) {
      // Sleep for a week, or wake early when the payment arrives.
      if (waitUntil(() -> payment != null, Duration.ofDays(7))) {
        return CompletableFuture.completedFuture(true);
      }
      mailer.sendReminder(invoice);
    }
    // Three weeks later, on whichever host is running by then.
    mailer.handToCollections(invoice);
    return CompletableFuture.completedFuture(false);
  }

  @SignalMethod
  public void paid(Payment payment) {
    this.payment = payment;
  }
}`;

const timerKotlin = `class InvoiceCollection : Workflow() {
  private val mailer = actions<Mailer>()

  @StateField var payment: Payment? = null

  @WorkflowMethod
  suspend fun collect(invoice: Invoice): Boolean {
    mailer.sendInvoice(invoice)

    repeat(3) {
      // Sleep for a week, or wake early when the payment arrives.
      if (waitUntil({ payment != null }, Duration.ofDays(7))) return true
      mailer.sendReminder(invoice)
    }
    // Three weeks later, on whichever host is running by then.
    mailer.handToCollections(invoice)
    return false
  }

  @SignalMethod
  fun paid(payment: Payment) {
    this.payment = payment
  }
}`;

const patterns = [
