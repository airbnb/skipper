---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; heroNav?: boolean; }
const {
  title = 'Skipper — Durable execution for workflows and AI agents, embedded in your service',
  description = 'Skipper is durable execution for workflows and AI agents on the JVM, embedded in your service. Write agent orchestration and business logic in plain Java or Kotlin and let Skipper run it to completion despite failures — no cluster to operate, no new database.',
  heroNav = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <Nav heroNav={heroNav} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
