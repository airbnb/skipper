---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Page not found — Skipper" description="The page you were looking for doesn't exist.">
  <section class="section" style="text-align:center;">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1 style="font-size: clamp(2rem, 4vw, 2.8rem);">Page not found</h1>
      <p style="color: var(--muted); font-size: 1.12rem; max-width: 46ch; margin: 0 auto 1.8rem;">
        The page you were looking for doesn't exist or may have moved.
      </p>
      <a class="btn btn--primary" href={`${base}/`}>Back to home</a>
    </div>
  </section>
</Layout>
